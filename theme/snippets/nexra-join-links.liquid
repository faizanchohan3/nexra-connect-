{%- comment -%}
  Nexra LLC account links (loaded on every page from snippets/oldIE-js.liquid).
  Logged out: Login / Register / Account links go to /pages/customer-login.
  Logged in: the header account icon opens a menu with Seller Dashboard, My orders and Log out,
  and the seller dashboard's top bar gets a Log out button.
  Links marked data-nx-direct are left alone.
{%- endcomment -%}
{%- unless customer -%}
<script>
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a || a.hasAttribute('data-nx-direct')) return;
    var u;
    try { u = new URL(a.getAttribute('href'), location.href); } catch (err) { return; }
    if (u.origin !== location.origin) return;
    if (/^\/(account(\/login|\/register)?|customer_authentication\/(login|redirect))\/?$/.test(u.pathname)) {
      e.preventDefault();
      location.href = '/pages/customer-login';
    }
  }, true);
</script>
{%- else -%}
<style>
  .nx-acct-menu{position:absolute;z-index:9999;min-width:230px;background:#fff;border:1px solid #e3e6ee;border-radius:14px;box-shadow:0 14px 40px rgba(20,30,60,.18);padding:8px;display:none;font-size:14px;text-align:left}
  .nx-acct-menu.on{display:block}
  .nx-acct-menu .nx-hi{padding:10px 12px 8px;border-bottom:1px solid #eef0f5;margin-bottom:6px;color:#5b6378;font-size:12.5px;line-height:1.4}
  .nx-acct-menu .nx-hi b{display:block;color:#1b2440;font-size:14px}
  .nx-acct-menu a{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:9px;color:#1b2440 !important;font-weight:600;text-decoration:none !important}
  .nx-acct-menu a:hover{background:#f4f5f9}
  .nx-acct-menu a.nx-dash{background:#1b2440;color:#fff !important;margin-bottom:4px}
  .nx-acct-menu a.nx-dash:hover{background:#252f52}
  .nx-acct-menu a.nx-out{color:#c8101a !important;border-top:1px solid #eef0f5;border-radius:0 0 9px 9px;margin-top:4px}
  .nx-acct-menu svg{width:17px;height:17px;flex:0 0 17px}
  .nx-dash-fab{position:fixed;right:18px;bottom:18px;z-index:9998;background:#1b2440;color:#fff !important;font-weight:800;font-size:14px;border-radius:30px;padding:12px 18px;box-shadow:0 10px 26px rgba(20,30,60,.25);text-decoration:none !important}
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var DASH = '/pages/reseller-dashboard';
  var LOGOUT = {{ routes.account_logout_url | json }};
  var ACCOUNT = {{ routes.account_url | json }};
  var NAME = {{ customer.first_name | default: customer.name | default: customer.email | json }};
  var EMAIL = {{ customer.email | json }};
  var onDash = location.pathname.indexOf(DASH) === 0;

  // 1. Seller dashboard page: add Log out to the top bar.
  var topRight = document.querySelector('.nxd-top-right');
  if (topRight && !document.getElementById('nx-dash-logout')) {
    var lo = document.createElement('a');
    lo.id = 'nx-dash-logout'; lo.href = LOGOUT; lo.className = 'nxd-btn sm line'; lo.setAttribute('data-nx-direct', '');
    lo.textContent = 'Log out';
    topRight.appendChild(lo);
    var back = document.querySelector('.nxd-back');
    if (back && back.parentNode) {
      var lo2 = document.createElement('a');
      lo2.href = LOGOUT; lo2.className = 'nxd-back'; lo2.setAttribute('data-nx-direct', ''); lo2.textContent = 'Log out';
      back.parentNode.appendChild(lo2);
    }
  }
  if (onDash) return;

  // 2. Everywhere else: turn the header account icon into a menu.
  var ic = {
    dash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>',
    bag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>',
    out: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>'
  };
  function esc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
  var menu = document.createElement('div');
  menu.className = 'nx-acct-menu';
  menu.innerHTML =
    '<div class="nx-hi"><b>Hi, ' + esc(NAME) + '</b>' + esc(EMAIL) + '</div>' +
    '<a class="nx-dash" href="' + DASH + '" data-nx-direct>' + ic.dash + 'Seller Dashboard</a>' +
    '<a href="' + ACCOUNT + '" data-nx-direct>' + ic.bag + 'My orders &amp; account</a>' +
    '<a class="nx-out" href="' + LOGOUT + '" data-nx-direct>' + ic.out + 'Log out</a>';
  document.body.appendChild(menu);

  function isAccountLink(a) {
    if (a.hasAttribute('data-nx-direct') || menu.contains(a)) return false;
    var u; try { u = new URL(a.getAttribute('href'), location.href); } catch (e) { return false; }
    return /\/account\/?$|\/account\/(login|register)\/?$|customer_authentication\/(login|redirect)/.test(u.pathname) &&
      (u.origin === location.origin || /shopify\.com$/.test(u.hostname));
  }
  var links = Array.prototype.filter.call(document.querySelectorAll('header a[href], .header-container a[href], .mobile-nav a[href], [id*="header"] a[href]'), isAccountLink);

  function openAt(a) {
    var r = a.getBoundingClientRect();
    menu.classList.add('on');
    var w = menu.offsetWidth;
    var left = Math.min(Math.max(8, r.right + window.scrollX - w), window.scrollX + document.documentElement.clientWidth - w - 8);
    menu.style.left = left + 'px';
    menu.style.top = (r.bottom + window.scrollY + 8) + 'px';
  }
  links.forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      if (menu.classList.contains('on')) menu.classList.remove('on'); else openAt(a);
    }, true);
  });
  document.addEventListener('click', function (e) { if (!menu.contains(e.target)) menu.classList.remove('on'); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') menu.classList.remove('on'); });

  // 3. If the theme shows no account icon (some layouts and phones), add a floating Dashboard button.
  var visible = links.some(function (a) { return a.offsetWidth > 0 || a.offsetHeight > 0; });
  if (!visible) {
    var fab = document.createElement('a');
    fab.className = 'nx-dash-fab'; fab.href = DASH; fab.setAttribute('data-nx-direct', ''); fab.textContent = 'Seller Dashboard';
    document.body.appendChild(fab);
  }
});
</script>
{%- endunless -%}
