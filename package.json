{
  "name": "nexra-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nexra LLC seller connector: push products to Shopify and WooCommerce stores, sync prices, import orders.",
  "scripts": {
    "test": "node --test --no-warnings test/*.test.js",
