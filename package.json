    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute nexra-connect --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
